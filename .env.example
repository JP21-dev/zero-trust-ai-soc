# =============================================================================
# SOC Hub configuration template. Copy to `.env` and fill in.
#   cp .env.example .env
# Non-secret settings ONLY. Secrets live in ./secrets/*.txt (Docker secrets),
# so they never show up in `docker inspect` or process environment dumps.
# =============================================================================

# --- Network binding ---------------------------------------------------------
# This machine's Tailscale IPv4 address. Get it with:  tailscale ip -4
# REQUIRED: compose refuses to start without it.
TAILSCALE_IP=100.x.y.z
ORCHESTRATOR_PORT=8080

# --- Images ------------------------------------------------------------------
# "latest" works, but pin a tag (e.g. 1.x.y) once things work so a surprise
# server upgrade can't break the chromadb-client API version.
CHROMA_IMAGE_TAG=latest

# --- App ---------------------------------------------------------------------
SOC_ENV=production
LOG_LEVEL=INFO
CHROMA_COLLECTION=soc_telemetry

# --- LLM engine --------------------------------------------------------------
# Pick a current Flash model from AI Studio (aistudio.google.com). Without an API
# key or if calls fail, the Strategist falls back to its built-in rules.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30

# --- Warden (human-in-the-loop breakpoint) -----------------------------------
# Threat scores (0-100) at or above this pause for FIDO2 approval.
WARDEN_THREAT_THRESHOLD=85
# How long a paused action waits for a signature before auto-denying.
WARDEN_APPROVAL_TIMEOUT_SECONDS=120
# WebAuthn relying party. Passkeys need HTTPS + a hostname, not a bare IP,
# so this is the hub's MagicDNS name, served over HTTPS by `tailscale serve`.
WEBAUTHN_RP_ID=soc-hub.your-tailnet.ts.net
WEBAUTHN_ORIGIN=https://soc-hub.your-tailnet.ts.net
# "webauthn" (real passkey signature check, needs an enrolled credential) or
# "simulated" (all checks except the signature; dev only, refused in production).
WARDEN_ASSERTION_MODE=webauthn
# Lifetime of a signed execution order once approved.
EXECUTION_ORDER_TTL_SECONDS=300
# true: accept synced Google Password Manager passkeys. false: device-bound only.
WARDEN_ALLOW_SYNCED_PASSKEYS=true

# Dashboard (https://<hub>.ts.net/dashboard): sign in with an enrolled passkey,
# then a session cookie lasts this many hours (max 168). A Hub restart signs you out.
DASHBOARD_SESSION_HOURS=12
